{
  "name": "chordvox",
  "version": "1.5.133",
  "description": "A desktop dictation application using whisper.cpp for speech-to-text transcription",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": "11.9.x"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "compile:globe": "node scripts/build-globe-listener.js",
    "compile:permission-helper": "node scripts/build-mac-permission-helper.js",
    "compile:fast-paste": "node scripts/build-macos-fast-paste.js",
    "compile:winkeys": "node scripts/build-windows-key-listener.js",
    "compile:winpaste": "node scripts/build-windows-fast-paste.js",
    "compile:linux-paste": "node scripts/build-linux-fast-paste.js",
    "compile:native": "npm run compile:globe && npm run compile:permission-helper && npm run compile:fast-paste && npm run compile:winkeys && npm run compile:winpaste && npm run compile:linux-paste",
    "prestart": "npm run compile:native",
    "start": "electron .",
    "predev": "npm run compile:native",
    "dev": "concurrently -k -r \"npm:dev:renderer\" \"npm:dev:main\"",
    "predev:main": "npm run compile:native",
    "dev:main": "cross-env NODE_ENV=development node scripts/run-electron.js --dev",
    "dev:renderer": "cd src && vite",
    "prebuild": "npm run compile:native && npm run download:node-runtime && npm run download:whisper-cpp && npm run download:llama-server && npm run download:sherpa-onnx",
    "build": "npm run build:production && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "build:renderer": "cd src && vite build",
    "build:electron": "node scripts/build-electron.js",
    "build:production": "npm run build:renderer && npm run build:electron",
    "prebuild:mac": "npm run compile:native && npm run download:node-runtime && npm run download:whisper-cpp && npm run download:llama-server && npm run download:sherpa-onnx",
    "setup:mac:signing": "bash scripts/ensure-macos-signing-identity.sh",
    "install:mac:local": "bash scripts/install-macos-local-build.sh",
    "build:mac": "npm run build:production && node scripts/build-mac-dmg.js",
    "prebuild:mac:customer": "npm run compile:native && npm run download:node-runtime && npm run download:whisper-cpp && npm run download:llama-server && npm run download:sherpa-onnx",
    "build:mac:customer": "npm run build:production && node scripts/build-mac-dmg.js",
    "prebuild:mac:test": "npm run compile:native && npm run download:node-runtime && npm run download:whisper-cpp && npm run download:llama-server && npm run download:sherpa-onnx",
    "build:mac:test": "npm run build:production && node scripts/build-mac-dmg.js --test",
    "build:mac:dmg": "npm run build:production && node scripts/build-mac-dmg.js",
    "build:mac:dmg:test": "npm run build:production && node scripts/build-mac-dmg.js --test",
    "prebuild:win": "npm run compile:native && npm run download:node-runtime && npm run download:whisper-cpp && npm run download:llama-server && npm run download:sherpa-onnx && npm run download:nircmd && npm run download:windows-fast-paste && npm run download:windows-key-listener",
    "build:win:package": "npm run build:production && electron-builder --config electron-builder.win.cjs --win",
    "build:win": "npm run build:win:package && npm run verify:win:package && npm run verify:win:authenticode",
    "prebuild:linux": "npm run compile:native && npm run download:node-runtime && npm run download:whisper-cpp && npm run download:llama-server && npm run download:sherpa-onnx",
    "build:linux:package": "npm run build:production && electron-builder --linux",
    "build:linux": "npm run build:linux:package && npm run verify:linux:package",
    "setup": "node setup.js",
    "prepack": "npm run compile:native && npm run download:node-runtime && npm run download:whisper-cpp && npm run download:llama-server && npm run download:sherpa-onnx",
    "pack": "npm run build:production && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "predist": "npm run compile:native && npm run download:node-runtime && npm run download:whisper-cpp && npm run download:llama-server && npm run download:sherpa-onnx",
    "dist": "npm run build:production && electron-builder",
    "download:whisper-cpp": "node scripts/download-whisper-cpp.js --current",
    "download:whisper-cpp:all": "node scripts/download-whisper-cpp.js --all",
    "download:llama-server": "node scripts/download-llama-server.js --current",
    "download:sherpa-onnx": "node scripts/download-sherpa-onnx.js --current",
    "download:sherpa-onnx:all": "node scripts/download-sherpa-onnx.js --all",
    "download:punct": "node scripts/download-punctuation-model.js",
    "download:node-runtime": "node scripts/download-node-runtime.js --current",
    "download:node-runtime:all": "node scripts/download-node-runtime.js --all",
    "download:nircmd": "node scripts/download-nircmd.js",
    "download:windows-fast-paste": "node scripts/download-windows-fast-paste.js",
    "download:windows-key-listener": "node scripts/download-windows-key-listener.js",
    "download:release-dictation-model": "node scripts/download-release-dictation-model.js",
    "format:js": "eslint . --fix && cd src && eslint . --fix && prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format": "npm run format:js",
    "format:check": "eslint . && cd src && eslint . && prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "lint": "eslint . && cd src && eslint .",
    "typecheck": "cd src && tsc --noEmit",
    "verify:mac:package": "node scripts/verify-mac-package.js --platform mac",
    "verify:win:package": "node scripts/verify-mac-package.js --platform win",
    "verify:win:authenticode": "pwsh -NoProfile -File scripts/verify-windows-authenticode.ps1",
    "verify:linux:package": "node scripts/verify-mac-package.js --platform linux",
    "verify:electron:bundle": "node scripts/build-electron.js --verify-only",
    "verify:icons": "node scripts/verify-icons.js",
    "verify:dmg-config": "node scripts/verify-dmg-config.js",
    "preview:dmg-background": "node scripts/build-mac-dmg.js --preview-background dist/dmg-background-preview.png",
    "quality-check": "npm run format:check && npm run typecheck",
    "i18n:check": "node scripts/check-i18n.js",
    "i18n:check:release": "node scripts/check-i18n.js --strict-locales=de,es,fr,it,pt,ru",
    "verify:ci": "npm run lint && npm run typecheck && npm test && npm run i18n:check:release && npm run verify:icons",
    "preview": "cd src && vite preview",
    "clean": "node cleanup.js",
    "test": "vitest run",
    "test:e2e": "npm run build:renderer && playwright test",
    "test:e2e:real": "npm run build:renderer && cross-env CHORDVOX_E2E_REAL_DICTATION=1 playwright test tests/e2e/dictation-flow.real.spec.ts",
    "verify:release:dictation": "node scripts/verify-release-real-dictation.js",
    "verify:packaged:dictation": "node scripts/verify-packaged-real-dictation.js",
    "verify:installed:dictation": "node scripts/verify-packaged-real-dictation.js --installed-mac",
    "test:watch": "vitest"
  },
  "keywords": [
    "dictation",
    "speech-to-text",
    "whisper",
    "whisper.cpp",
    "electron",
    "desktop-app"
  ],
  "author": {
    "name": "ChordVox Team",
    "email": "support@chordvox.com"
  },
  "license": "UNLICENSED",
  "homepage": "https://chordvox.com",
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^1.8.0",
    "@electron/notarize": "^3.0.1",
    "@eslint/js": "^9.25.0",
    "@neondatabase/auth": "^0.2.0-beta.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "cross-env": "^10.0.0",
    "electron": "^41.10.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@sentry/electron": "^7.14.0",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dbus-next": "^0.10.2",
    "dotenv": "^16.3.1",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0",
    "graceful-fs": "^4.2.11",
    "i18next": "^25.8.4",
    "lucide-react": "^0.518.0",
    "object-assign": "^4.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.7.4",
    "react-markdown": "^10.1.0",
    "shadcn-ui": "^0.9.5",
    "sherpa-onnx-node": "^1.12.34",
    "tailwind-merge": "^3.3.1",
    "tar": "^7.5.13",
    "tw-animate-css": "^1.3.4",
    "unzipper": "^0.12.3",
    "ws": "^8.20.0"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "^1.1.1"
  },
  "overrides": {
    "better-auth": "^1.6.23",
    "defu": "^6.1.7",
    "form-data": "^2.5.5",
    "kysely": "^0.28.17",
    "minimatch": "^9.0.9",
    "usocket": "^1.0.3",
    "uuid": "^14.0.0",
    "xml2js": "^0.6.2"
  },
  "allowScripts": {
    "electron@41.5.0": true
  }
}
